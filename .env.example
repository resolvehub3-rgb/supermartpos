# ==============================================================================
# AFRIMART POS - ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# ==============================================================================

# Supabase Client Configuration (Safe for frontend exposure via VITE_ prefix)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Privileged Supabase Key (Strictly server-side only; NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Base Application URL (for redirects, customer display links, and webhook callbacks)
VITE_APP_URL="http://localhost:3000"

# Gmail SMTP Configuration for Transactional Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false" # set to true for port 465 (SSL)
SMTP_USER="notifications@yourdomain.com"
SMTP_PASSWORD="your-16-character-google-app-password"
SMTP_FROM_EMAIL="notifications@yourdomain.com"
SMTP_FROM_NAME="Afrimart POS Cloud"

# Payment Provider Configuration for Recurring Tenant Subscriptions
PAYMENT_PROVIDER_PUBLIC_KEY="pk_live_your_payment_provider_public_key"
PAYMENT_PROVIDER_SECRET_KEY="sk_live_your_payment_provider_secret_key"
PAYMENT_PROVIDER_WEBHOOK_SECRET="whsec_your_webhook_signature_secret"
